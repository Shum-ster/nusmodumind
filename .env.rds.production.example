# Optional Amazon RDS mode used by docker-compose.rds.yml. URL-encode reserved
# password characters and keep the RDS instance private inside the EC2 VPC.
DATABASE_URL=postgresql://nusmodumind_app:replace-with-a-strong-url-encoded-password@your-rds-endpoint.ap-southeast-1.rds.amazonaws.com:5432/nusmodumind?schema=public&sslmode=require
DIRECT_URL=postgresql://nusmodumind_app:replace-with-a-strong-url-encoded-password@your-rds-endpoint.ap-southeast-1.rds.amazonaws.com:5432/nusmodumind?schema=public&sslmode=require

JWT_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.6-terra
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_EMAIL="NUSModuMind <notifications@your-verified-domain.com>"
RESEND_TEST_RECIPIENT=
FRONTEND_URL=https://app.example.com
NUSMODS_ACAD_YEAR=2026-2027
NEXT_PUBLIC_API_BASE_URL=/api
SITE_ADDRESS=app.example.com
