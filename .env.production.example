# Local PostgreSQL container used by docker-compose.prod.yml. Keep the existing
# production values when upgrading an EC2 host with live data.
POSTGRES_DB=nusmodumind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql://postgres:replace-with-a-url-encoded-database-password@postgres:5432/nusmodumind?schema=public
DIRECT_URL=postgresql://postgres:replace-with-a-url-encoded-database-password@postgres:5432/nusmodumind?schema=public

JWT_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5.6-terra
RESEND_API_KEY=replace-with-your-resend-api-key
RESEND_FROM_EMAIL="NUSModuMind <notifications@your-verified-domain.com>"
RESEND_TEST_RECIPIENT=
FRONTEND_URL=http://13.215.185.237
NUSMODS_ACAD_YEAR=2026-2027

# The no-domain deployment uses Caddy to route /api to the backend.
NEXT_PUBLIC_API_BASE_URL=/api

# IP-only launch for the current EC2 host. Replace both URL values with a real
# hostname and HTTPS after DNS is configured.
SITE_ADDRESS=http://13.215.185.237
