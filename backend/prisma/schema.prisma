// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String         @map("password_hash")

  semesters     Semester[]
  moduleReviews ModuleReview[]

  @@map("users")
}

model NusModule {
  moduleCode    String   @id @map("module_code")
  title         String
  description   String?
  moduleCredit  Int      @map("module_credit")
  department    String
  faculty       String
  prerequisite  String?
  preclusion    String?
  workload      String?
  semesterData  Json?    @map("semester_data")
  lastUpdated   DateTime @default(now()) @updatedAt @map("last_updated")

  plannedModules PlannedModule[]
  moduleReviews  ModuleReview[]

  @@map("nus_modules")
}

model Semester {
  id              String          @id @default(uuid()) @db.Uuid
  acadYear        String          @map("acad_year") // e.g., "2023/2024"
  semesterNumber  Int             @map("semester_number") // 1 or 2
  userId          String          @map("user_id") @db.Uuid
  
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedModules  PlannedModule[]

  @@map("semesters")
}

model PlannedModule {
  id              String    @id @default(uuid()) @db.Uuid
  semesterId      String    @map("semester_id") @db.Uuid
  moduleCode      String    @map("module_code")
  expectedGrade   String?   @map("expected_grade")
  actualGrade     String?   @map("actual_grade")
  selectedLessons Json?     @map("selected_lessons")

  semester        Semester  @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  module          NusModule @relation(fields: [moduleCode], references: [moduleCode], onDelete: Restrict)

  @@map("planned_modules")
}

model ModuleReview {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  moduleCode String   @map("module_code")
  rating     Int      // 1-10 scale
  content    String   @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  module     NusModule @relation(fields: [moduleCode], references: [moduleCode], onDelete: Cascade)

  @@map("module_reviews")
}