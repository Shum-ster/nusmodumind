@startuml Marketplace_Create_Public_Plan_Sequence

title Marketplace - Create Public Degree Plan

hide footbox
skinparam shadowing false
skinparam sequence {
    ArrowColor #2F3A4A
    LifeLineBorderColor #2F3A4A
    ParticipantBorderColor #2F3A4A
    ParticipantBackgroundColor #FFFFFF
}

actor Student
participant "PopularChoicesSubmitPage" as SubmitPage
participant "Dashboard Plan Export" as PlanExport
participant "popular-choices-api.ts" as PopularChoicesApi
participant "JWT AuthGuard" as JwtGuard
participant "PublicPlansController" as PublicPlansController
participant "PublicPlansService" as PublicPlansService
database "PostgreSQL" as DB

Student -> SubmitPage : Open submission page
SubmitPage -> PlanExport : Validate dashboard and build plan snapshot
PlanExport -> PlanExport : Render degree-plan image
PlanExport --> SubmitPage : planSnapshot and planImageDataUrl
SubmitPage -> PopularChoicesApi : getCurrentUserPublicPlan(token)
PopularChoicesApi -> JwtGuard : GET /public-plans/me
JwtGuard -> PublicPlansController : findCurrentUserPlan(currentUser)
PublicPlansController -> PublicPlansService : findCurrentUserPlan(user.id)
PublicPlansService -> DB : SELECT public_plan by author_id
DB --> SubmitPage : Existing plan or null

Student -> SubmitPage : Submit title, description and optional cover
SubmitPage -> PopularChoicesApi : createPublicPlan(token, body)
PopularChoicesApi -> JwtGuard : POST /public-plans\nAuthorization: Bearer token

alt Token missing or invalid
    JwtGuard --> SubmitPage : 401 Unauthorized
else Token valid
    JwtGuard -> PublicPlansController : create(currentUser, dto)
    PublicPlansController -> PublicPlansService : create(user.id, dto)
    PublicPlansService -> DB : SELECT user faculty and degree
    DB --> PublicPlansService : Academic profile

    alt Faculty or degree is missing
        PublicPlansService --> SubmitPage : 400 Bad Request
    else Academic profile is complete
        PublicPlansService -> DB : SELECT public_plan by author_id
        DB --> PublicPlansService : Existing plan or null

        alt User already has a public plan
            PublicPlansService --> SubmitPage : 409 Conflict
        else No existing public plan
            PublicPlansService -> DB : INSERT snapshot, plan image,\ncover image and author
            DB --> PublicPlansService : Created public plan
            PublicPlansService --> SubmitPage : 201 Created
            SubmitPage --> Student : Open new public plan detail page
        end
    end
end

@enduml
