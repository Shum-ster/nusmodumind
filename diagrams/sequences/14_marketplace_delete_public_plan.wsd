@startuml Marketplace_Delete_Public_Plan_Sequence

title Marketplace - Delete Public Degree Plan

hide footbox
skinparam shadowing false
skinparam sequence {
    ArrowColor #2F3A4A
    LifeLineBorderColor #2F3A4A
    ParticipantBorderColor #2F3A4A
    ParticipantBackgroundColor #FFFFFF
}

actor Student
participant "MySubmittedDegreePlanPage" as SubmittedPlanPage
participant "popular-choices-api.ts" as PopularChoicesApi
participant "JWT AuthGuard" as JwtGuard
participant "PublicPlansController" as PublicPlansController
participant "PublicPlansService" as PublicPlansService
database "PostgreSQL" as DB

Student -> SubmittedPlanPage : Delete submitted degree plan
SubmittedPlanPage -> PopularChoicesApi : deletePublicPlan(token, id)
PopularChoicesApi -> JwtGuard : DELETE /public-plans/:id\nAuthorization: Bearer token

alt Token missing or invalid
    JwtGuard --> SubmittedPlanPage : 401 Unauthorized
else Token valid
    JwtGuard -> PublicPlansController : remove(currentUser, id)
    PublicPlansController -> PublicPlansService : remove(user.id, id)
    PublicPlansService -> DB : Find plan with author and reviews\nwithout incrementing view count
    DB --> PublicPlansService : Public plan or null

    alt Public plan not found
        PublicPlansService --> SubmittedPlanPage : 404 Not Found
    else Public plan belongs to another user
        PublicPlansService --> SubmittedPlanPage : 403 Forbidden
    else Current user authored public plan
        PublicPlansService -> DB : DELETE public_plans
        DB --> PublicPlansService : Deleted plan
        PublicPlansService --> SubmittedPlanPage : 200 OK
        SubmittedPlanPage --> Student : Clear submitted-plan view
    end
end

@enduml
