@startuml Course_Catalog_Search_Modules_Sequence

title Course Catalog - Browse Modules

hide footbox
skinparam shadowing false
skinparam sequence {
    ArrowColor #2F3A4A
    LifeLineBorderColor #2F3A4A
    ParticipantBorderColor #2F3A4A
    ParticipantBackgroundColor #FFFFFF
}

actor Student
participant "CourseCatalog" as CourseCatalog
participant "courses-api.ts" as CoursesApi
participant "NusmoduleController" as NusmoduleController
participant "NusmoduleService" as NusmoduleService
database "PostgreSQL" as DB

Student -> CourseCatalog : Open Courses page
CourseCatalog -> CoursesApi : searchNusModules({ limit: 50 })
CoursesApi -> NusmoduleController : GET /nusmodule?cursor&limit
NusmoduleController -> NusmoduleService : findAll(options)
NusmoduleService -> NusmoduleService : Normalize cursor and limit
NusmoduleService -> DB : SELECT nus_modules\nORDER BY module_code\nLIMIT limit + 1
DB --> NusmoduleService : Modules
NusmoduleService -> NusmoduleService : Build items and nextCursor
NusmoduleService --> NusmoduleController : { items, nextCursor }
NusmoduleController --> CoursesApi : Catalog response
CoursesApi --> CourseCatalog : Initial module page
CourseCatalog --> Student : Render module catalog

loop Student scrolls near the end or selects Load More
    Student -> CourseCatalog : Request more modules
    CourseCatalog -> CoursesApi : searchNusModules({ cursor, limit: 50 })
    CoursesApi -> NusmoduleController : GET /nusmodule?cursor&limit
    NusmoduleController -> NusmoduleService : findAll(options)
    NusmoduleService -> DB : SELECT next module page
    DB --> NusmoduleService : Modules
    NusmoduleService --> CourseCatalog : Items and nextCursor
    CourseCatalog --> Student : Append modules without duplicates
end

Student -> CourseCatalog : Select a module
CourseCatalog --> Student : Navigate to /courses/{moduleCode}

@enduml
