@startuml Backend_Scheduled_NUSMods_Sync_Sequence

title Backend Jobs - Scheduled NUSMods Sync

hide footbox
skinparam shadowing false
skinparam sequence {
    ArrowColor #2F3A4A
    LifeLineBorderColor #2F3A4A
    ParticipantBorderColor #2F3A4A
    ParticipantBackgroundColor #FFFFFF
}

participant "GitHub Actions" as Actions
participant "sync-nusmods.ts" as SyncScript
participant "NusModulesCronService" as CronService
participant "NUSMods API" as NUSModsApi
participant "ModuleChangeDetectorService" as ChangeDetector
participant "ModuleChangeNotificationService" as NotificationService
database "Supabase PostgreSQL" as DB

Actions -> Actions : Trigger nightly at 00:00 SGT
Actions -> Actions : Checkout, npm ci
Actions -> DB : prisma migrate deploy
DB --> Actions : Schema up to date
Actions -> SyncScript : npm run sync:nusmods\nNUSMODS_ACAD_YEAR=2026-2027
SyncScript -> SyncScript : Create isolated NusmoduleSyncModule
SyncScript -> CronService : syncNusModsData()

CronService -> NUSModsApi : GET moduleInfo.json
NUSModsApi --> CronService : Module information array

loop Fetch details, at most 20 concurrent requests
    CronService -> NUSModsApi : GET /modules/{moduleCode}.json
    alt Detail request succeeds
        NUSModsApi --> CronService : Timetable, exam and module data
    else Detail request fails
        NUSModsApi --> CronService : Error
        CronService -> CronService : Use summary data and preserve stored semester_data
    end
end

loop Process batches of 100 modules
    CronService -> DB : SELECT existing module snapshots
    DB --> CronService : Before-sync data
    CronService -> ChangeDetector : Compare stored and downloaded data
    ChangeDetector --> CronService : Relevant global and semester changes
    CronService -> NotificationService : buildDrafts(changes, AY, sync date)
    NotificationService -> DB : Find matching PLANNED modules\nby academic year and semester
    DB --> NotificationService : Affected users and planned modules
    NotificationService --> CronService : Deduplicated outbox rows

    CronService -> DB : BEGIN transaction\nBulk upsert modules\nCreate notification rows
    DB --> CronService : COMMIT
end

CronService -> NotificationService : dispatchPending()
ref over NotificationService, DB
    Notification delivery is detailed in
    22_backend_module_change_email_notification.wsd
end ref
NotificationService --> CronService : Delivery attempts completed
CronService --> SyncScript : Sync complete
SyncScript -> SyncScript : Close application context
SyncScript --> Actions : Exit successfully

@enduml
