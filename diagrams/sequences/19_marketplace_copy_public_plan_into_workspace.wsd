@startuml Marketplace_Copy_Public_Plan_Into_Workspace_Sequence

title Marketplace - Copy Public Plan Into Own Workspace

hide footbox
skinparam shadowing false
skinparam sequence {
    ArrowColor #2F3A4A
    LifeLineBorderColor #2F3A4A
    ParticipantBorderColor #2F3A4A
    ParticipantBackgroundColor #FFFFFF
}

actor Student
participant "Public Plan Detail Page" as PlanDetailPage
participant "popular-choices-api.ts" as PopularChoicesApi
participant "planner-api.ts" as PlannerApi
participant "JWT AuthGuard" as JwtGuard
participant "PublicPlansController" as PublicPlansController
participant "PublicPlansService" as PublicPlansService
participant "SemestersController" as SemestersController
participant "SemestersService" as SemestersService
participant "PlannedModulesController" as PlannedModulesController
participant "PlannedModulesService" as PlannedModulesService
database "PostgreSQL" as DB

note over PlanDetailPage, PlannedModulesService #FFF3CD
No copy action is currently wired into the frontend.
This diagram documents the proposed orchestration using existing APIs.
end note

Student -> PlanDetailPage : Copy public plan
PlanDetailPage -> PopularChoicesApi : getPublicPlan(id)
PopularChoicesApi -> PublicPlansController : GET /public-plans/:id
PublicPlansController -> PublicPlansService : findOne(id)
PublicPlansService -> DB : Increment view_count and return plan_snapshot
DB --> PublicPlansService : public plan detail
PublicPlansService --> PopularChoicesApi : public plan detail
PopularChoicesApi --> PlanDetailPage : planSnapshot

PlanDetailPage -> PlanDetailPage : Read semesters and modules from planSnapshot

loop For each semester in snapshot
    PlanDetailPage -> PlannerApi : createSemester(token, semester)
    PlannerApi -> JwtGuard : POST /semesters\nAuthorization: Bearer token
    JwtGuard -> SemestersController : create(currentUser, dto)
    SemestersController -> SemestersService : create(user.id, dto)
    SemestersService -> DB : INSERT semesters
    DB --> SemestersService : new semester
    SemestersService --> SemestersController : new semester
    SemestersController --> PlannerApi : 201 Created
    PlannerApi --> PlanDetailPage : new semester id
end

loop For each planned module in snapshot
    PlanDetailPage -> PlannerApi : createPlannedModule(token, copied module)
    PlannerApi -> JwtGuard : POST /planned-modules\nAuthorization: Bearer token
    JwtGuard -> PlannedModulesController : create(currentUser, dto)
    PlannedModulesController -> PlannedModulesService : create(user.id, dto)
    PlannedModulesService -> DB : INSERT planned_modules
    DB --> PlannedModulesService : new planned module
    PlannedModulesService --> PlannedModulesController : new planned module
    PlannedModulesController --> PlannerApi : 201 Created
    PlannerApi --> PlanDetailPage : new planned module
end

PlanDetailPage --> Student : Public plan appears in own dashboard/workspace

@enduml
