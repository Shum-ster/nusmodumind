@startuml Dashboard_Update_Module_Status_Sequence

title Dashboard / Planner - Update Module Status

hide footbox
skinparam shadowing false
skinparam sequence {
    ArrowColor #2F3A4A
    LifeLineBorderColor #2F3A4A
    ParticipantBorderColor #2F3A4A
    ParticipantBackgroundColor #FFFFFF
}

actor Student
participant "DashboardPage" as DashboardPage
participant "planner-api.ts" as PlannerApi
participant "JWT AuthGuard" as JwtGuard
participant "PlannedModulesController" as PlannedModulesController
participant "PlannedModulesService" as PlannedModulesService
database "PostgreSQL" as DB

Student -> DashboardPage : Move module or change status
DashboardPage -> PlannerApi : updatePlannedModule(token, id, patch)
PlannerApi -> JwtGuard : PATCH /planned-modules/:id\nAuthorization: Bearer token

alt Token missing or invalid
    JwtGuard --> PlannerApi : 401 Unauthorized
    PlannerApi --> DashboardPage : Display auth error
else Token valid
    JwtGuard -> PlannedModulesController : update(currentUser, id, dto)
    PlannedModulesController -> PlannedModulesService : update(user.id, id, dto)
    PlannedModulesService -> DB : SELECT planned_module by id
    DB --> PlannedModulesService : existing planned module

    alt Planned module belongs to another user
        PlannedModulesService --> PlannedModulesController : ForbiddenException
        PlannedModulesController --> PlannerApi : 403 Forbidden
    else Current user owns planned module
        PlannedModulesService -> PlannedModulesService : Merge existing values with patch
        PlannedModulesService -> PlannedModulesService : Normalize status and semesterId

        alt New status is PLANNED
            PlannedModulesService -> DB : SELECT semester by id
            DB --> PlannedModulesService : semester
            PlannedModulesService -> PlannedModulesService : Ensure semester belongs to user
        else New status is SELECTED or EXEMPTED
            PlannedModulesService -> PlannedModulesService : Clear semesterId
        end

        PlannedModulesService -> DB : UPDATE planned_modules
        DB --> PlannedModulesService : Updated planned module
        PlannedModulesService --> PlannedModulesController : Updated record with module and semester
        PlannedModulesController --> PlannerApi : 200 OK
    end

    PlannerApi --> DashboardPage : Result or error
    DashboardPage --> Student : Refresh planner layout
end

@enduml
