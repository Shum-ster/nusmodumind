@startuml Backend_Manual_NUSMods_Sync_Sequence

title Backend Jobs - Manual NUSMods Sync

hide footbox
skinparam shadowing false
skinparam sequence {
    ArrowColor #2F3A4A
    LifeLineBorderColor #2F3A4A
    ParticipantBorderColor #2F3A4A
    ParticipantBackgroundColor #FFFFFF
}

actor Developer
participant "npm script" as NpmScript
participant "sync-nusmods.ts" as SyncScript
participant "NusmoduleSyncModule" as SyncModule
participant "NusModulesCronService" as CronService
participant "NUSMods API" as NUSModsApi
participant "Change and Notification Services" as ChangeServices
database "PostgreSQL" as DB

Developer -> NpmScript : npm run sync:nusmods
NpmScript -> SyncScript : Start standalone TypeScript script
SyncScript -> SyncModule : createApplicationContext(NusmoduleSyncModule)
SyncModule --> SyncScript : Isolated application context
SyncScript -> CronService : syncNusModsData()
CronService -> NUSModsApi : Download module list and detailed data
NUSModsApi --> CronService : Module, timetable and exam data

loop Process batches of 100 modules
    CronService -> DB : Load before-sync module snapshots
    DB --> CronService : Existing data
    CronService -> ChangeServices : Detect relevant changes and build drafts
    ChangeServices -> DB : Find matching PLANNED modules\nfor the synced year and semester
    DB --> ChangeServices : Affected users
    ChangeServices --> CronService : Notification outbox rows
    CronService -> DB : Atomic bulk upsert and outbox insert
    DB --> CronService : Batch committed
end

CronService -> ChangeServices : Dispatch pending notification emails
ChangeServices --> CronService : Sent or retained for retry
CronService --> SyncScript : Sync complete

alt Sync succeeds
    SyncScript -> SyncModule : app.close()
    SyncModule --> SyncScript : Closed
    SyncScript --> Developer : Exit code 0
else Sync fails
    SyncScript -> SyncModule : app.close() in finally
    SyncModule --> SyncScript : Closed
    SyncScript --> Developer : Log error and exit code 1
end

@enduml
