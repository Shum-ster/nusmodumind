@startuml Backend_Manual_NUSMods_Sync_Sequence

title Backend Jobs - Manual NUSMods Sync

hide footbox
skinparam shadowing false
skinparam sequence {
    ArrowColor #2F3A4A
    LifeLineBorderColor #2F3A4A
    ParticipantBorderColor #2F3A4A
    ParticipantBackgroundColor #FFFFFF
}

actor Developer
participant "npm script" as NpmScript
participant "sync-nusmods.ts" as SyncScript
participant "Nest ApplicationContext" as AppContext
participant "NusModulesCronService" as CronService
participant "HttpService" as HttpService
participant "NUSMods API" as NUSModsApi
database "PostgreSQL" as DB

Developer -> NpmScript : npm run sync:nusmods
NpmScript -> SyncScript : ts-node sync-nusmods.ts
SyncScript -> AppContext : NestFactory.createApplicationContext(AppModule)
AppContext --> SyncScript : Application context
SyncScript -> AppContext : app.get(NusModulesCronService)
AppContext --> SyncScript : Cron service instance
SyncScript -> CronService : syncNusModsData()
CronService -> HttpService : GET NUSMods moduleInfo.json
HttpService -> NUSModsApi : HTTPS request
NUSModsApi --> HttpService : Module info array
HttpService --> CronService : modules
CronService -> CronService : Map NUSMods fields to NusModule data

loop In batches of 500 modules
    CronService -> DB : Transaction of nusModule.upsert operations
    DB --> CronService : Batch upsert result
end

CronService --> SyncScript : Sync complete
SyncScript -> AppContext : app.close()
AppContext --> SyncScript : Closed
SyncScript --> Developer : Command exits

@enduml
