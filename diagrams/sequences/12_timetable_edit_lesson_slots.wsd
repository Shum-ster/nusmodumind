@startuml Timetable_Edit_Lesson_Slots_Sequence

title Timetable - Editing Lesson Slots

hide footbox
skinparam shadowing false
skinparam sequence {
    ArrowColor #2F3A4A
    LifeLineBorderColor #2F3A4A
    ParticipantBorderColor #2F3A4A
    ParticipantBackgroundColor #FFFFFF
}

actor Student
participant "TimetablePage" as TimetablePage
participant "timetable-api.ts" as TimetableApi
participant "planner-api.ts" as PlannerApi
participant "JWT AuthGuard" as JwtGuard
participant "PlannedModulesController" as PlannedModulesController
participant "PlannedModulesService" as PlannedModulesService
database "PostgreSQL" as DB

Student -> TimetablePage : Select or edit lesson slot
TimetablePage -> TimetableApi : Build selectedLessons JSON
TimetableApi -> PlannerApi : updatePlannedModule(token, id, { selectedLessons })
PlannerApi -> JwtGuard : PATCH /planned-modules/:id\nAuthorization: Bearer token

alt Token missing or invalid
    JwtGuard --> PlannerApi : 401 Unauthorized
    PlannerApi --> TimetableApi : Error
    TimetableApi --> TimetablePage : Display auth error
else Token valid
    JwtGuard -> PlannedModulesController : update(currentUser, id, dto)
    PlannedModulesController -> PlannedModulesService : update(user.id, id, dto)
    PlannedModulesService -> DB : SELECT planned_module by id
    DB --> PlannedModulesService : existing planned module
    PlannedModulesService -> PlannedModulesService : Merge selectedLessons into normalized update data
    PlannedModulesService -> DB : UPDATE planned_modules.selected_lessons
    DB --> PlannedModulesService : Updated planned module
    PlannedModulesService --> PlannedModulesController : Updated record
    PlannedModulesController --> PlannerApi : 200 OK
    PlannerApi --> TimetableApi : Updated planned module
    TimetableApi --> TimetablePage : Updated timetable data
    TimetablePage --> Student : Show edited lesson slot
end

@enduml
