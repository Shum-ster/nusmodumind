@startuml C4_Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title System Context Diagram for Academic Planning System

Person(student, "Student", "A university student managing their academic plan.")

System(academic_planner, "Academic Planning System", "Allows students to plan their 4-year academic plan.")

System_Ext(nusmods_api, "NUSMods API", "Provides module data, schedule, venue updates.")
System_Ext(google_calendar, "Google Calendar API", "Syncs user timetables to their personal Google Calendar.")
System_Ext(email_service, "Email Service", "External service for sending notification emails.")
System_Ext(llm_service, "AI LLM Provider", "External AI service that processes system prompt and outputs recommendations.")

Rel(student, academic_planner, "Uses")
Rel(nusmods_api, academic_planner, "Fetches data to")
Rel(academic_planner, google_calendar, "Exports timetables to")
Rel(academic_planner, email_service, "Sends emails using")
Rel(academic_planner, llm_service, "Uses")
Rel(email_service, student, "Sends emails to")

@enduml